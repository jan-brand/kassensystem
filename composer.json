{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "jan-brand/kassensystem",
  "type": "project",
  "description": "Tablet-optimiertes Laravel-Kassensystem für Schulcafeteria und Gastronomie mit POS, Bargeldführung, Administration, Reporting und Audit.",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "laravel/framework": "^13.0",
    "laravel/tinker": "^3.0",
    "livewire/livewire": "^4.4"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "larastan/larastan": "^3.11",
    "laravel/pail": "^1.2",
    "laravel/pint": "^1.27",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "pestphp/pest": "^4.7",
    "pestphp/pest-plugin-laravel": "^4.1",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate",
      "@php artisan env:sync --yes",
      "npm install",
      "npm run build",
      "@php artisan app:init --no-interaction"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently \"php artisan serve\" \"npm run dev\" --names=server,vite --kill-others"
    ],
    "lint": "@php vendor/bin/pint --test --parallel",
    "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G --no-progress",
    "qa:static": [
      "@lint",
      "@analyse"
    ],
    "test": "@php artisan test",
    "qa": [
      "composer validate --no-check-publish",
      "@lint",
      "@analyse",
      "@test",
      "@php artisan app:check",
      "npm run build"
    ],
    "qa:acceptance": [
      "@php artisan module:check",
      "@php artisan architecture:check",
      "@php artisan permission:check",
      "@php artisan navigation:check",
      "@php artisan page:check",
      "@php artisan test tests/Feature/Acceptance"
    ],
    "qa:release": [
      "@qa",
      "@php scripts/production/release-artifacts.php",
      "@qa:acceptance"
    ],
    "release:status": "@php scripts/production/final-release-check.php --status-only",
    "release:final-check": "@php scripts/production/final-release-check.php",
    "security": [
      "composer audit --locked",
      "npm audit --audit-level=high"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
