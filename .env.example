# Application
APP_NAME="Webapp Foundation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

# Foundation
FOUNDATION_DASHBOARD=true
FOUNDATION_DEFAULT_SURFACE=public
FOUNDATION_STRICT=true

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

# Session / Cache / Queue
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Files
FILESYSTEM_DISK=local

# Mail
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend
VITE_APP_NAME="${APP_NAME}"


# Kassensystem
KASSENSYSTEM_CURRENCY=EUR
KASSENSYSTEM_TIMEZONE=Europe/Berlin

KASSENSYSTEM_PIN_LENGTH=6
KASSENSYSTEM_PIN_MAX_ATTEMPTS=5
KASSENSYSTEM_PIN_LOCK_SECONDS=60
KASSENSYSTEM_BACKUP_DIRECTORY=storage/app/backups/database
KASSENSYSTEM_MYSQL_DUMP_BINARY=mysqldump
KASSENSYSTEM_MYSQL_CLIENT_BINARY=mysql
